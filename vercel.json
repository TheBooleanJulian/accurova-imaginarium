{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build && npm run build:api",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api" }],
  "functions": { "api/index.mjs": { "maxDuration": 300, "memory": 1024, "includeFiles": "supabase/**" } },
  "crons": [{ "path": "/api/worker/tick", "schedule": "*/10 * * * *" }]
}
