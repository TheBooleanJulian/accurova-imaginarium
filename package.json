{
  "name": "accurova-imaginarium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --tsconfig tsconfig.server.json server/index.ts",
    "dev:full": "node scripts/dev-full.mjs",
    "build": "tsc -b && vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --tsconfig=tsconfig.server.json --outfile=dist-server/index.mjs",
    "build:api": "esbuild server/vercel.ts --bundle --platform=node --format=esm --target=node20 --packages=external --tsconfig=tsconfig.server.json --outfile=api/index.mjs",
    "start": "node dist-server/index.mjs",
    "db:migrate": "tsx --tsconfig tsconfig.server.json scripts/migrate.ts",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/functions": "^3.10.3",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "hono": "^4.13.13",
    "jose": "^6.2.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.61.0",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "description": "Accurova Imaginarium: AI preshoot moodboards, node editor, shot planning and client approvals for Accurova.",
  "engines": {
    "node": ">=20.11"
  }
}
