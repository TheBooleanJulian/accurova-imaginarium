# ─────────────────────────────────────────────────────────────────────────────
# Accurova Imaginarium: configuration
# Copy to .env (never commit it). Everything has a safe local default, so
# `npm run dev:full` works with no .env at all (PGlite + local files + mock AI).
# ─────────────────────────────────────────────────────────────────────────────

# ── Frontend (baked into the build; public) ──────────────────────────────────
# `server` talks to the API. Leave unset for the browser-only demo (`npm run dev`).
VITE_BACKEND=server
# Only if the frontend and API are on different origins (e.g. https://api.example.com).
VITE_API_URL=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=development
# Local data: PGlite database, local file storage, generated dev secrets.
DATA_DIR=.data
# Comma-separated origins allowed to call the API cross-origin (only if VITE_API_URL is used).
CORS_ORIGINS=

# ── Database ─────────────────────────────────────────────────────────────────
# Empty = embedded PGlite under DATA_DIR (zero install).
# Supabase: Project Settings → Database → Connection string.
#   Long-running server (VPS/Render/Railway): session pooler or direct, port 5432.
#   Vercel / serverless: transaction pooler, port 6543 (keep DB_PREPARE=false).
DATABASE_URL=
DB_PREPARE=false
DB_POOL_MAX=10
# Run migrations on start. Defaults to true in development/PGlite, false in production.
# On Supabase prefer `supabase db push` OR `npm run db:migrate`, not both on one database.
MIGRATE_ON_START=

# ── Auth ─────────────────────────────────────────────────────────────────────
# dev      = sign in with email only (local development; refused in production
#            unless ALLOW_DEV_AUTH=true)
# supabase = Supabase Auth (email + password, confirmation emails)
AUTH_MODE=dev
ALLOW_DEV_AUTH=false
SUPABASE_URL=
# Public by design (protected by RLS). Sent to the browser for sign-in.
SUPABASE_ANON_KEY=
# SECRET. Server only. Used for Storage (signed URLs, uploads).
SUPABASE_SERVICE_ROLE_KEY=
# Optional, legacy HS256 projects only: verify tokens locally instead of calling Supabase.
SUPABASE_JWT_SECRET=

# ── Storage ──────────────────────────────────────────────────────────────────
# local    = files under DATA_DIR/storage, served via HMAC-signed URLs
# supabase = private bucket (created by the storage migration)
STORAGE=local
STORAGE_BUCKET=project-assets
# Secret for signed URLs / upload tokens. Auto-generated under DATA_DIR if empty.
SIGNING_SECRET=
SIGNED_URL_TTL_SECONDS=3600
MAX_UPLOAD_MB=20
MAX_ASSETS_PER_PROJECT=500

# ── AI provider (server only; keys never reach the browser) ──────────────────
# mock   = deterministic, clearly-labelled placeholder output, no cost
# openai = Responses API (vision + structured JSON) and Images API
AI_PROVIDER=mock
MOCK_LATENCY_MS=600
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Any vision-capable model that supports JSON-schema structured outputs.
OPENAI_TEXT_MODEL=gpt-4.1
# gpt-image-2 (default), a newer gpt-image-2.x, or gpt-image-1 / 1.5.
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TIMEOUT_MS=180000
# Optional USD per 1M tokens, only for the cost estimate shown per job.
OPENAI_PRICE_TEXT_IN=
OPENAI_PRICE_TEXT_OUT=
OPENAI_PRICE_IMAGE_IN=
OPENAI_PRICE_IMAGE_OUT=

# ── Jobs & limits ────────────────────────────────────────────────────────────
# inline = this process also works the queue. off = API only (another process or cron works it).
WORKER=inline
WORKER_CONCURRENCY=2
WORKER_POLL_MS=1500
MAX_CONCURRENT_JOBS_PER_PROJECT=2
MAX_JOBS_PER_USER_PER_DAY=60
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_MS=2000
JOB_LEASE_SECONDS=600
# Protects /api/worker/tick (Vercel Cron sends it as a bearer token).
CRON_SECRET=
