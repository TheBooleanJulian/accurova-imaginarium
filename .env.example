# --- Frontend (safe to expose: anon key is public by design, protected by RLS) ---
# Leave both empty to run in LOCAL mode (browser storage + mock AI, no accounts needed).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

